rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow users to read and write their own profile
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Allow users to read all rooms, but only owners/co-creators can write/update
    match /rooms/{roomId} {
      allow read: if true;
      allow write: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.userId == request.auth.uid || 
        ('coCreatorId' in resource.data && resource.data.coCreatorId == request.auth.uid)
      );
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    
    // Artworks associated with rooms
    match /artworks/{artworkId} {
      allow read: if true;
      allow create: if request.auth != null && (
        get(/databases/$(database)/documents/rooms/$(request.resource.data.roomId)).data.userId == request.auth.uid ||
        ('coCreatorId' in get(/databases/$(database)/documents/rooms/$(request.resource.data.roomId)).data && get(/databases/$(database)/documents/rooms/$(request.resource.data.roomId)).data.coCreatorId == request.auth.uid)
      );
      allow update: if request.auth != null && (
        get(/databases/$(database)/documents/rooms/$(resource.data.roomId)).data.userId == request.auth.uid ||
        ('coCreatorId' in get(/databases/$(database)/documents/rooms/$(resource.data.roomId)).data && get(/databases/$(database)/documents/rooms/$(resource.data.roomId)).data.coCreatorId == request.auth.uid)
      );
      allow delete: if request.auth != null && (
        get(/databases/$(database)/documents/rooms/$(resource.data.roomId)).data.userId == request.auth.uid ||
        ('coCreatorId' in get(/databases/$(database)/documents/rooms/$(resource.data.roomId)).data && get(/databases/$(database)/documents/rooms/$(resource.data.roomId)).data.coCreatorId == request.auth.uid)
      );
    }
    
    // Partnerships for social features
    match /partnerships/{partnershipId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (request.auth.uid == resource.data.user1 || request.auth.uid == resource.data.user2);
    }
    
    // Ratings
    match /room_ratings/{ratingId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    // Guestbook entries
    match /guestbook/{entryId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && (
        resource.data.userId == request.auth.uid || 
        get(/databases/$(database)/documents/rooms/$(resource.data.roomId)).data.userId == request.auth.uid
      );
    }
    
    // Notifications
    match /notifications/{notificationId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.ownerId;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.ownerId;
    }

    // Chats
    match /chats/{chatId} {
      allow read, write: if request.auth != null && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null;
    }

    // Messages associated with chats
    match /messages/{messageId} {
      allow read: if request.auth != null && 
        resource.data.chatId != null &&
        request.auth.uid in get(/databases/$(database)/documents/chats/$(resource.data.chatId)).data.participants;
      allow create: if request.auth != null && 
        request.resource.data.chatId != null &&
        request.auth.uid in get(/databases/$(database)/documents/chats/$(request.resource.data.chatId)).data.participants;
      allow update: if request.auth != null && 
        resource.data.chatId != null &&
        request.auth.uid in get(/databases/$(database)/documents/chats/$(resource.data.chatId)).data.participants;
      allow delete: if request.auth != null && 
        resource.data.chatId != null &&
        (request.auth.uid == resource.data.senderId || 
         request.auth.uid in get(/databases/$(database)/documents/chats/$(resource.data.chatId)).data.participants);
    }
  }
}
